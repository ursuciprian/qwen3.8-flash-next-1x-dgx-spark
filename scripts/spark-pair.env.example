# Copy to ~/.config/spark-pair.env on each Spark (and on any machine that runs these scripts) and fill in the values.
# This file is a template; the real one is never committed.
SPARK_HEAD_IP=<cx7-ip-a>
SPARK_WORKER_IP=<cx7-ip-b>
SPARK_CX7_PREFIX=<cx7-prefix-with-trailing-dot>
SPARK_HEAD_LAN=<head-ip>
SPARK_WORKER_LAN=<worker-ip>
